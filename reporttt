# -*- coding: utf-8 -*-

import dataiku
import pandas as pd
from datetime import datetime

# ==========================================================
# READ INPUT
# ==========================================================

REPORTT = dataiku.Dataset("REPORTT")
df = REPORTT.get_dataframe()

# ==========================================================
# DYNAMIC HEADERS
# ==========================================================

today = datetime.today()

fte_header = today.strftime("%d-%b-%y")
los_header = today.strftime("%d %b LoS")

df = df.rename(columns={
    "FTE_sum": fte_header,
    "Curr Date LOS": los_header
})

# ==========================================================
# NUMERIC COLUMNS
# ==========================================================

numeric_cols = [

    fte_header,
    "Employees",
    "Agency Workers",
    "New Joiners",
    "Offers Accepted",
    "Total Leavers",
    "EW Leavers",
    "FG Leavers",
    "Net Transfer",
    "Net LoS",
    "%",
    los_header,
    "CP 26 DEC 26",
    "WFP Outlook DEC 26",
    "CP-26 vs LoS",
    "30Jun WFP Outlook vs LoS",
    "JRs+Vacant Positions"

]

for c in numeric_cols:

    if c in df.columns:

        df[c] = (
            pd.to_numeric(
                df[c],
                errors="coerce"
            )
            .fillna(0)
            .round(1)
        )

# ==========================================================
# HIERARCHY
# ==========================================================

OPS = [
    "Ops CIB",
    "Ops WRB",
    "FCSO"
]

TECH = [
    "T&A",
    "TI",
    "ICS",
    "CDO",
    "Markets",
    "GCIO",
    "GCIO - IM",
    "IM",
    "aXess"
]

COO_CHILDREN = [
    "Risk & Control",
    "Resilience",
    "Delivery",
    "Governance"
]

# ==========================================================
# OUTPUT
# ==========================================================

rows = []


# ==========================================================
# HELPER FUNCTIONS
# ==========================================================

def sum_values(data):
    """
    Sum every numeric column.
    """

    totals = {}

    for col in numeric_cols:
        totals[col] = data[col].sum()

    return totals


def mt_total(data, mt):
    """
    Return totals of one MT Domain.
    """

    return sum_values(
        data[data["MT Domain"] == mt]
    )


def group_total(data, mt_list):
    """
    Return totals of multiple MT Domains.
    """

    return sum_values(
        data[data["MT Domain"].isin(mt_list)]
    )


def append_row(name, values):
    """
    Append one row to output.
    """

    row = {
        "MT Domain": name
    }

    for col in numeric_cols:
        row[col] = values.get(col, 0)

    rows.append(row)


def append_mt(data, mt):
    """
    Append one MT row.
    """

    append_row(
        mt,
        mt_total(data, mt)
    )


def append_group(data, label, mt_list):
    """
    Append subtotal row.
    """

    append_row(
        label,
        group_total(data, mt_list)
    )


def append_coo(data, expand=False):
    """
    COO block.
    """

    # COO Total
    append_row(
        "COO",
        group_total(data, COO_CHILDREN)
    )

    # Expand only if required
    if expand:

        for mt in COO_CHILDREN:

            append_row(
                "    " + mt,
                mt_total(data, mt)
            )


def append_cio_total(data):
    """
    CIO Mgmt Total
    """

    temp = data[
        data["MT Domain"].isin(
            COO_CHILDREN +
            ["Gp Mgmt", "GBS"]
        )
    ]

    append_row(
        "CIO Mgmt Total",
        sum_values(temp)
    )
# ==========================================================
# TOTAL SECTION
# ==========================================================

def build_total():

    total_df = df.copy()

    # Grand Total
    append_row(
        "Total",
        sum_values(total_df)
    )

    # ---------------- OPS ----------------

    append_list(
    total_df,
    OPS
)

    append_group(
        total_df,
        "Ops Total",
        OPS
    )

    # ---------------- TECH ----------------

    append_list(
    total_df,
    TECH
)

    append_group(
        total_df,
        "Tech Total",
        TECH
    )

    # ---------------- COO ----------------
    # Don't expand in Total

    append_coo(
        total_df,
        expand=False
    )

    append_mt(total_df, "Gp Mgmt")
    append_mt(total_df, "GBS")

# ==========================================================
# BAU SECTION
# ==========================================================

def build_bau():

    bau_df = df[df["Cost Cat"] == "BAU"].copy()

    # Grand BAU Total
    append_row(
        "BAU",
        sum_values(bau_df)
    )

    # ---------------- OPS ----------------

    append_list(
    bau_df,
    OPS
)

    append_group(
        bau_df,
        "Ops Total",
        OPS
    )

    # ---------------- TECH ----------------

    append_list(
    bau_df,
    TECH
)

    append_group(
        bau_df,
        "Tech Total",
        TECH
    )

    

    # ---------------- COO ----------------
    # Expand only in BAU

    append_coo(
        bau_df,
        expand=True
    )

    # ---------------- Gp Mgmt ----------------

    append_mt(
        bau_df,
        "Gp Mgmt"
    )

    # ---------------- GBS ----------------

    append_mt(
        bau_df,
        "GBS"
    )

    # ---------------- CIO Mgmt Total ----------------

    append_cio_total(
        bau_df
    )

def append_list(data, mt_list):
    
    for mt in mt_list:

        append_mt(
            data,
            mt
        )

# ==========================================================
# PROJECT SECTION
# ==========================================================

def build_project():

    project_df = df[
        df["Cost Cat"] == "Project"
    ].copy()

    # ------------------------------------------------------
    # PROJECT TOTAL
    # ------------------------------------------------------

    append_row(
        "Project",
        sum_values(project_df)
    )

    # ---------------- OPS ----------------

    append_list(
        project_df,
        OPS
    )

    append_group(
        project_df,
        "Ops Total",
        OPS
    )

    # ---------------- TECH ----------------

    append_list(
        project_df,
        TECH
    )

    append_group(
        project_df,
        "Tech Total",
        TECH
    )

    # ---------------- COO ----------------

    append_coo(
        project_df,
        expand=True
    )

    # ---------------- Gp Mgmt ----------------

    append_mt(
        project_df,
        "Gp Mgmt"
    )

    # ---------------- GBS ----------------

    append_mt(
        project_df,
        "GBS"
    )

    # NO CIO MGMT TOTAL HERE

# ==========================================================
# BUILD REPORT
# ==========================================================

build_total()

build_bau()

build_project()

# ==========================================================
# FINAL DATAFRAME
# ==========================================================

final_df = pd.DataFrame(rows)

# MT Domain first
cols = ["MT Domain"] + [
    c for c in final_df.columns
    if c != "MT Domain"
]

final_df = final_df[cols]

# ==========================================================
# WRITE OUTPUT
# ==========================================================

REPORTTT = dataiku.Dataset("REPORTTT")

REPORTTT.write_with_schema(final_df)

print(final_df)
