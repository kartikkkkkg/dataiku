# -*- coding: utf-8 -*-

import dataiku
import pandas as pd
import numpy as np
from datetime import datetime

# ============================================================
# READ INPUT DATASET
# ============================================================

REPORTT = dataiku.Dataset("REPORTT")
df = REPORTT.get_dataframe()

# ============================================================
# DYNAMIC DATE HEADERS
# ============================================================

today = datetime.today()

fte_header = today.strftime("%d-%b-%y")        # 16-Jul-26
los_header = today.strftime("%d %b LoS")       # 16 Jul LoS

df.rename(columns={
    "FTE_sum": fte_header,
    "Curr Date LOS": los_header
}, inplace=True)

# ============================================================
# NUMERIC COLUMNS
# ============================================================

numeric_cols = [
    fte_header,
    "Employees",
    "Agency Workers",
    "New Joiners",
    "Offers Accepted",
    "Total Leavers",
    "EW Leavers",
    "FG Leavers",
    "Net Transfer",
    "Net LoS",
    "%",
    los_header,
    "CP 26 DEC 26",
    "WFP Outlook DEC 26",
    "CP-26 vs LoS",
    "30Jun WFP Outlook vs LoS",
    "JRs+Vacant Positions"
]

for c in numeric_cols:
    if c in df.columns:
        df[c] = pd.to_numeric(df[c], errors="coerce").fillna(0)

# ============================================================
# GROUP DEFINITIONS
# ============================================================

OPS = [
    "Ops CIB",
    "Ops WRB",
    "FCSO"
]

TECH = [
    "T&A",
    "TI",
    "ICS",
    "CDO",
    "Markets",
    "GCIO",
    "GCIO - IM",
    "IM",
    "aXess"
]

COO_CHILDREN = [
    "Risk & Control",
    "Resilience",
    "Delivery",
    "Governance"
]

CIO = [
    "COO",
    "Gp Mgmt",
    "GBS"
]

# ============================================================
# RESULT LIST
# ============================================================

rows = []


# ============================================================
# HELPER FUNCTIONS
# ============================================================

def sum_numeric(data):
    """
    Sum all numeric columns in a dataframe.
    """
    result = {}

    for col in numeric_cols:
        if col in data.columns:
            result[col] = data[col].sum()

    return result


def add_row(name, cost_cat, values):
    """
    Add one row to final output.
    """

    row = {
        "MT Domain": name,
        "Cost Cat": cost_cat
    }

    for col in numeric_cols:
        row[col] = values.get(col, 0)

    rows.append(row)


def get_mt(mt, data):
    """
    Return totals of one MT Domain.
    """

    temp = data[
        data["MT Domain"] == mt
    ]

    return sum_numeric(temp)


def get_group(mt_list, data):
    """
    Return totals of multiple MT Domains.
    """

    temp = data[
        data["MT Domain"].isin(mt_list)
    ]

    return sum_numeric(temp)


def create_coo(data):
    """
    COO =
    Risk & Control +
    Resilience +
    Delivery +
    Governance
    """

    return get_group(COO_CHILDREN, data)


def create_ops_total(data):
    """
    Ops Total
    """

    return get_group(OPS, data)


def create_tech_total(data):
    """
    Tech Total
    """

    return get_group(TECH, data)


def create_cio_total(data):
    """
    CIO Mgmt =
    COO +
    Gp Mgmt +
    GBS
    """

    temp = pd.concat([

        data[data["MT Domain"].isin(COO_CHILDREN)],

        data[data["MT Domain"] == "Gp Mgmt"],

        data[data["MT Domain"] == "GBS"]

    ])

    return sum_numeric(temp)


def create_section_total(data):
    """
    Grand total of section.
    """

    return sum_numeric(data)

# ============================================================
# BUILD TOTAL SECTION
# ============================================================

# All data
total_df = df.copy()

# ------------------------------------------------------------
# TOTAL
# ------------------------------------------------------------

add_row(
    "Total",
    "",
    create_section_total(total_df)
)

# ------------------------------------------------------------
# OPS
# ------------------------------------------------------------

for mt in OPS:

