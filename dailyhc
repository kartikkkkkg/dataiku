def build_html_table_from_summary(
    df: pd.DataFrame, curr_label: str, last_label: str
) -> str:
    df_html = df.copy()
    df_html = df_html.replace({np.nan: ""})

    if "Comments" in df_html.columns:
        df_html["Comments"] = (
            df_html["Comments"].astype(str).replace("nan", "").str.replace("\n", "<br>")
        )

    col_order = ["COST CAT", "MT DOMAIN", last_label, curr_label, "Net Change", "Comments"]
    col_order = [c for c in col_order if c in df_html.columns]
    df_html = df_html[col_order]

    table_style = "border-collapse:collapse;font-family:Calibri,Arial,sans-serif;font-size:11px;"
    th_style = "border:1px solid #999999;padding:4px 6px;background-color:#F0F0F0;font-weight:bold;text-align:center;"
    td_base = "border:1px solid #999999;padding:4px 6px;vertical-align:top;"

    col_widths = {"COST CAT": 90, "MT DOMAIN": 120, curr_label: 70, last_label: 70, "Net Change": 70, "Comments": 260}
    total_labels = set(TOTAL_LABELS.values())
    grand_label = GRAND_TOTAL_LABEL

    html = [f'<table style="{table_style}">']

    html.append("<tr>")
    for col in col_order:
        width = col_widths.get(col, 80)
        html.append(f'<th style="{th_style}width:{width}px;">{col}</th>')
    html.append("</tr>")

    for _, row in df_html.iterrows():
        costcat = str(row.get("COST CAT", ""))

        if costcat == grand_label:
            row_bg, row_weight = "#D0D0D0", "bold"
        elif costcat in total_labels:
            row_bg, row_weight = "#E0E0E0", "bold"
        else:
            row_bg, row_weight = "#FFFFFF", "normal"

        html.append("<tr>")
        for col in col_order:
            val = row[col]
            val = "" if pd.isna(val) or val is None else str(val)
            if val == "nan": val = ""
            
            style = td_base + f"background-color:{row_bg};font-weight:{row_weight};"
            style += "text-align:center;" if col in (curr_label, last_label, "Net Change") else "text-align:left;"

            html.append(f'<td style="{style}">{val}</td>')
        html.append("</tr>")

    html.append("</table>")
    return "\n".join(html)


# ==========================================
# MAIN EXECUTION
# ==========================================
def main():
    print("Reading Recipe Inputs from Dataiku Datasets...")
    daily_hc_df = dataiku.Dataset("daily_hc").get_dataframe()
    dailyrollup_df = dataiku.Dataset("dailyrollup").get_dataframe()
    lastmonth_hc_df = dataiku.Dataset("lastmonth_hc").get_dataframe()
    mapping_df = dataiku.Dataset("mapping").get_dataframe()
    lastmonth_rollup_df = dataiku.Dataset("lastmonth_rollup").get_dataframe()
    
    # Initialize Output Folder exactly as shown in screenshot
    HC_Output_Reports = dataiku.Folder("SatdiEQ1")

    print("Processing mappings...")
    bf_map, emp_map = process_mapping_df(mapping_df)

    print("Processing Rollups...")
    curr_rollup = process_rollup_df(dailyrollup_df)
    rollup_gbf_map = (
        curr_rollup[[COL_ROLLUP_ID, COL_ROLLUP_GBF]]
        .assign(**{COL_ROLLUP_ID: lambda x: x[COL_ROLLUP_ID].astype(str).str.strip()})
        .set_index(COL_ROLLUP_ID)[COL_ROLLUP_GBF]
        .to_dict()
    )

    last_rollup = process_rollup_df(lastmonth_rollup_df)
    last_rollup_gbf_map = (
        last_rollup[[COL_ROLLUP_ID, COL_ROLLUP_GBF]]
        .assign(**{COL_ROLLUP_ID: lambda x: x[COL_ROLLUP_ID].astype(str).str.strip()})
        .drop_duplicates(subset=[COL_ROLLUP_ID])
        .set_index(COL_ROLLUP_ID)[COL_ROLLUP_GBF]
        .to_dict()
    )

    print("Applying mappings to HC data...")
    hc_curr = apply_mappings_to_hc(daily_hc_df, bf_map, emp_map)
    hc_last = apply_mappings_to_hc(lastmonth_hc_df, bf_map, emp_map)

    print("Building snapshots...")
    snap_curr = build_snapshot(hc_curr, "curr")
    snap_last = build_snapshot(hc_last, "last")

    print("Combining snapshots...")
    combined = snap_last.merge(
        snap_curr,
        on=COL_BANK_ID,
        how="outer",
        suffixes=("_last", "_curr"),
    )

    print("Classifying movements...")
    movements = classify_movements(combined, set(last_rollup_gbf_map.keys()), rollup_gbf_map)

    print("Building comments...")
    comments_df = build_comments_for_controllable(movements)

    print("Building HC summary (controllable)...")
    hc_summary = build_hc_summary_controllable(hc_curr, hc_last)

    print("Merging summary with comments...")
    merged = hc_summary.merge(comments_df, on="MT_CC", how="left")
    merged["Comments"] = merged["Comments"].fillna("")

    merged.loc[merged["Net_Change"].abs() <= COMMENT_THRESHOLD, "Comments"] = ""
    merged = merged[[COL_COST_CAT, COL_MT_DOMAIN, "HC_Last", "HC_Current", "Net_Change", "Comments"]]
    merged = sort_cost_cat_mt(merged)

    print("Adding totals rows...")
    merged_with_totals = add_totals_rows(
        merged,
        curr_col="HC_Current",
        last_col="HC_Last",
        net_col="Net_Change",
    )

    curr_label, last_label = get_date_labels()
    merged_with_totals.rename(
        columns={
            "HC_Current": curr_label,
            "HC_Last": last_label,
            "Net_Change": "Net Change",
            COL_COST_CAT: "COST CAT",
            COL_MT_DOMAIN: "MT DOMAIN",
        },
        inplace=True,
    )

    # ---------------------------------------------------------
    # EXPORT TO DATAIKU MANAGED FOLDER
    # ---------------------------------------------------------
    file_label = curr_label.replace("-", "")
    filename = f"HC_{file_label}.xlsx"
    temp_path = f"/tmp/{filename}" # Save to Dataiku temporary OS space first

    print(f"Writing temporary Excel file to {temp_path}...")
    merged_with_totals.to_excel(temp_path, sheet_name=OUTPUT_SHEET_NAME, index=False)

    print("Applying Excel formatting...")
    style_professional(temp_path)

    print("Uploading styled Excel to Output Managed Folder...")
    with open(temp_path, "rb") as f:
        HC_Output_Reports.upload_stream(filename, f)
        
    # Clean up temp file
    os.remove(temp_path)
    
    # ---------------------------------------------------------
    # PASS HTML TABLE TO SCENARIO VARIABLES
    # ---------------------------------------------------------
    print("Generating HTML Email Table...")
    html_table = build_html_table_from_summary(merged_with_totals, curr_label, last_label)
    
    client = dataiku.api_client()
    project = client.get_default_project()
    variables = project.get_variables()
    
    # These variables will be consumed by the Scenario step to send the email
    variables["standard"]["HTML_EMAIL_TABLE"] = html_table
    variables["standard"]["REPORT_DATE"] = curr_label
    project.set_variables(variables)

    print("Process Complete. HTML table passed to project variables for Email Scenario.")

if __name__ == "__main__":
