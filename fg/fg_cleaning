import pandas as pd
import dataiku

# ============================================
# READ DATASETS
# ============================================

# Original raw FG dataset
fg_raw = dataiku.Dataset("FG_Raw").get_dataframe()

# Final FG dataset after joins
fg_final = dataiku.Dataset("FG_Final_Joined").get_dataframe()

# ============================================
# CLEAN POSITION IDS
# ============================================

fg_raw["Position ID"] = (
    fg_raw["Position ID"]
    .astype(str)
    .str.replace(".0", "", regex=False)
    .str.strip()
)

fg_final["Position ID"] = (
    fg_final["Position ID"]
    .astype(str)
    .str.replace(".0", "", regex=False)
    .str.strip()
)

# ============================================
# GET ORIGINAL COUNTS
# ============================================

raw_counts = (
    fg_raw
    .groupby("Position ID")
    .size()
    .reset_index(name="raw_count")
)

# ============================================
# ADD ROW NUMBER IN FINAL DATASET
# ============================================

fg_final["row_num"] = (
    fg_final
    .groupby("Position ID")
    .cumcount() + 1
)

# ============================================
# MERGE ORIGINAL COUNTS
# ============================================

fg_final = fg_final.merge(
    raw_counts,
    on="Position ID",
    how="left"
)

# If somehow missing in raw
fg_final["raw_count"] = fg_final["raw_count"].fillna(1)

# ============================================
# KEEP ONLY VALID ROWS
# ============================================

fg_final_cleaned = fg_final[
    fg_final["row_num"] <= fg_final["raw_count"]
]

# ============================================
# DROP HELPER COLUMNS
# ============================================

fg_final_cleaned = fg_final_cleaned.drop(
    columns=["row_num", "raw_count"],
    errors="ignore"
)

# ============================================
# WRITE OUTPUT
# ============================================

output = dataiku.Dataset("FG_Cleaned")

output.write_with_schema(fg_final_cleaned)
