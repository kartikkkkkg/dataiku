import dataiku
import pandas as pd

# Read datasets
raw = dataiku.Dataset("fg_raw").get_dataframe()
joined = dataiku.Dataset("fg_joined").get_dataframe()

# Clean Position ID
raw["Position ID"] = raw["Position ID"].astype(str)
joined["Position ID"] = joined["Position ID"].astype(str)

# Count Position IDs in original raw
raw_count = (
    raw.groupby("Position ID")
    .size()
    .reset_index(name="raw_count")
)

# Count Position IDs in joined dataset
joined["join_rank"] = (
    joined.groupby("Position ID")
    .cumcount() + 1
)

# Merge raw count
joined = joined.merge(
    raw_count,
    on="Position ID",
    how="left"
)

# Keep only rows within original count
joined = joined[
    joined["join_rank"] <= joined["raw_count"]
]

# Duplicate logic
joined["duplicate_rank"] = (
    joined.groupby("Position ID")
    .cumcount() + 1
)

# Final Status
def final_status(row):

    # Blank Position ID
    if pd.isna(row["Position ID"]) or row["Position ID"] == "":
        return "Excl - Blank Pos ID"

    # MOW/MSW
    if row["Employment Type"] in [
        "Managed Outcome Worker",
        "Managed Service Worker"
    ]:
        return "Excl - MOW/MSW"

    # In NJ
    if row["Check in NJ"] == "In New Joiner":
        return "Excl - in new joiner"

    # In Actuals
    if row["Check In Actuals"] == "In Actuals":
        return "Excl - in actuals"

    # Real duplicates
    if row["duplicate_rank"] > 1:
        return "Excl - duplicate"

    return "Include"

joined["Final Status"] = joined.apply(final_status, axis=1)

# Drop helper columns if needed
# joined = joined.drop(columns=["join_rank", "raw_count", "duplicate_rank"])

# Write output
output = dataiku.Dataset("fg_final")
output.write_with_schema(joined)
