import dataiku
import pandas as pd

# =========================================================
# READ DATASETS
# =========================================================

# Original FG raw dataset
raw = dataiku.Dataset("fg_raw").get_dataframe()

# Final FG dataset after joins
joined = dataiku.Dataset("fg_joined").get_dataframe()

# =========================================================
# CLEAN JOB REQUISITION ID
# =========================================================

raw["Job Requisition ID"] = (
    raw["Job Requisition ID"]
    .astype(str)
    .str.replace(".0", "", regex=False)
    .str.strip()
)

joined["Job Requisition ID"] = (
    joined["Job Requisition ID"]
    .astype(str)
    .str.replace(".0", "", regex=False)
    .str.strip()
)

# =========================================================
# REMOVE STRING 'nan'
# =========================================================

raw["Job Requisition ID"] = (
    raw["Job Requisition ID"]
    .replace("nan", "")
)

joined["Job Requisition ID"] = (
    joined["Job Requisition ID"]
    .replace("nan", "")
)

# =========================================================
# STEP 1 — COUNT RAW FG RECORDS
# =========================================================
# Count how many times each JR ID exists in raw FG

raw_count = (
    raw.groupby("Job Requisition ID")
    .size()
    .reset_index(name="raw_count")
)

# =========================================================
# STEP 2 — CREATE JOIN RANK
# =========================================================
# Helps identify fake duplicates created by joins

joined["join_rank"] = 1

mask = (
    joined["Job Requisition ID"].notna() &
    (joined["Job Requisition ID"] != "")
)

joined.loc[mask, "join_rank"] = (
    joined[mask]
    .groupby("Job Requisition ID")
    .cumcount() + 1
)

# =========================================================
# STEP 3 — MERGE RAW COUNTS
# =========================================================

joined = joined.merge(
    raw_count,
    on="Job Requisition ID",
    how="left"
)

joined["raw_count"] = (
    joined["raw_count"]
    .fillna(1)
)

# =========================================================
# STEP 4 — REMOVE FAKE DUPLICATES
# =========================================================
# Keep only same count as original raw FG

joined = joined[
    joined["join_rank"] <= joined["raw_count"]
]

# =========================================================
# STEP 5 — REAL DUPLICATE LOGIC
# =========================================================
# Among REAL duplicates:
# first row = valid
# second+ = Excl - duplicate

joined["duplicate_rank"] = 1

mask = (
    joined["Job Requisition ID"].notna() &
    (joined["Job Requisition ID"] != "")
)

joined.loc[mask, "duplicate_rank"] = (
    joined[mask]
    .groupby("Job Requisition ID")
    .cumcount() + 1
)

# =========================================================
# STEP 6 — FINAL STATUS LOGIC
# =========================================================

def final_status(row):

    # -----------------------------------------------------
    # Blank Position ID
    # -----------------------------------------------------

    if (
        pd.isna(row["Position ID"]) or
        str(row["Position ID"]).strip() == "" or
        str(row["Position ID"]).strip().lower() == "nan"
    ):
        return "Excl - Blank Pos ID"

    # -----------------------------------------------------
    # MOW / MSW
    # -----------------------------------------------------

    if str(row.get("Employment Type", "")).strip() in [
        "Managed Outcome Worker",
        "Managed Service Worker"
    ]:
        return "Excl - MOW/MSW"

    # -----------------------------------------------------
    # In New Joiner
    # -----------------------------------------------------

    if str(row.get("Check in NJ", "")).strip() == "In New Joiner":
        return "Excl - in new joiner"

    # -----------------------------------------------------
    # In Actuals
    # -----------------------------------------------------

    if str(row.get("Check In Actuals", "")).strip() == "In Actuals":
        return "Excl - in actuals"

    # -----------------------------------------------------
    # REAL DUPLICATES
    # -----------------------------------------------------

    if row["duplicate_rank"] > 1:
        return "Excl - duplicate"

    # -----------------------------------------------------
    # DEFAULT
    # -----------------------------------------------------

    return "Include"

# Apply logic
joined["Final Status"] = joined.apply(final_status, axis=1)

# =========================================================
# CLEANUP
# =========================================================

joined = joined.drop(
    columns=[
        "join_rank",
        "raw_count",
        "duplicate_rank"
    ],
    errors="ignore"
)

# =========================================================
# WRITE OUTPUT
# =========================================================

output = dataiku.Dataset("fg_final")

output.write_with_schema(joined)
