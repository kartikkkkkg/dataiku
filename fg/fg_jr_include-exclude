import dataiku
import pandas as pd

# =========================================================
# READ DATASETS
# =========================================================

# Original FG raw dataset
raw = dataiku.Dataset("fg_raw").get_dataframe()

# Joined FG dataset after all joins
joined = dataiku.Dataset("fg_joined").get_dataframe()

# =========================================================
# CLEAN KEY COLUMNS
# =========================================================

key_cols = ["Position ID", "Job Requisition ID"]

for col in key_cols:

    raw[col] = (
        raw[col]
        .astype(str)
        .str.replace(".0", "", regex=False)
        .str.strip()
        .replace("nan", "")
    )

    joined[col] = (
        joined[col]
        .astype(str)
        .str.replace(".0", "", regex=False)
        .str.strip()
        .replace("nan", "")
    )

# =========================================================
# LOGIC 1
# REMOVE FAKE DUPLICATES CREATED BY JOINS
# USING:
# Position ID + Job Requisition ID
# =========================================================

# Count original FG combinations
raw_count = (
    raw.groupby(["Position ID", "Job Requisition ID"])
    .size()
    .reset_index(name="raw_count")
)

# Create rank in joined dataset
joined["join_rank"] = (
    joined.groupby(["Position ID", "Job Requisition ID"])
    .cumcount() + 1
)

# Merge raw counts
joined = joined.merge(
    raw_count,
    on=["Position ID", "Job Requisition ID"],
    how="left"
)

# If missing, assume 1
joined["raw_count"] = joined["raw_count"].fillna(1)

# Keep only rows that existed in original FG
joined = joined[
    joined["join_rank"] <= joined["raw_count"]
]

# =========================================================
# LOGIC 2
# REAL POSITION ID DUPLICATES
# KEEP FIRST
# MARK OTHERS AS DUPLICATE
# =========================================================

joined["position_rank"] = 1

mask = (
    joined["Position ID"].notna() &
    (joined["Position ID"] != "") &
    (joined["Position ID"].str.lower() != "nan")
)

joined.loc[mask, "position_rank"] = (
    joined[mask]
    .groupby("Position ID")
    .cumcount() + 1
)

# =========================================================
# FINAL INCLUDE / EXCLUDE LOGIC
# =========================================================

def final_status(row):

    # -----------------------------------------------------
    # Blank Position ID
    # -----------------------------------------------------

    if (
        pd.isna(row["Position ID"]) or
        str(row["Position ID"]).strip() == "" or
        str(row["Position ID"]).strip().lower() == "nan"
    ):
        return "Excl - Blank Pos ID"

    # -----------------------------------------------------
    # MOW / MSW
    # -----------------------------------------------------

    if str(row.get("Employment Type", "")).strip() in [
        "Managed Outcome Worker",
        "Managed Service Worker"
    ]:
        return "Excl - MOW/MSW"

    # -----------------------------------------------------
    # REAL POSITION DUPLICATES
    # -----------------------------------------------------

    if row["position_rank"] > 1:
        return "Excl - duplicate"

    # -----------------------------------------------------
    # IN NEW JOINER
    # -----------------------------------------------------

    if str(row.get("Check in NJ", "")).strip() == "In New Joiner":
        return "Excl - in new joiner"

    # -----------------------------------------------------
    # IN ACTUALS
    # -----------------------------------------------------

    if str(row.get("Check In Actuals", "")).strip() == "In Actuals":
        return "Excl - in actuals"

    # -----------------------------------------------------
    # DEFAULT
    # -----------------------------------------------------

    return "Include"

# Apply final logic
joined["Final Status"] = joined.apply(final_status, axis=1)

# =========================================================
# CONVERT POSITION ID TO INTEGER
# =========================================================

joined["Position ID"] = pd.to_numeric(
    joined["Position ID"],
    errors="coerce"
)

joined["Position ID"] = joined["Position ID"].astype("Int64")

# =========================================================
# CLEANUP
# =========================================================

joined = joined.drop(
    columns=[
        "join_rank",
        "raw_count",
        "position_rank"
    ],
    errors="ignore"
)

# =========================================================
# WRITE OUTPUT
# =========================================================

output = dataiku.Dataset("fg_final")

output.write_with_schema(joined)
