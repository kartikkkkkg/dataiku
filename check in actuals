import dataiku
import pandas as pd
import numpy as np

# Read datasets
New_Joiners_prepared_joined = dataiku.Dataset("New_Joiners_prepared_joined")
HC_Joined = dataiku.Dataset("HC_Joined")

New_Joiners_prepared_joined_df = New_Joiners_prepared_joined.get_dataframe()
HC_Joined_df = HC_Joined.get_dataframe()

# =====================================================
# Clean Position ID
# =====================================================

New_Joiners_prepared_joined_df["Position ID"] = (
    New_Joiners_prepared_joined_df["Position ID"]
    .fillna("")
    .astype(str)
    .str.strip()
)

HC_Joined_df["Position ID"] = (
    HC_Joined_df["Position ID"]
    .fillna("")
    .astype(str)
    .str.strip()
)

# =====================================================
# Create lookup set
# =====================================================

hc_positions = set(HC_Joined_df["Position ID"])

# =====================================================
# Create HC flag
# =====================================================

New_Joiners_prepared_joined_df["hc_flag"] = (
    New_Joiners_prepared_joined_df["Position ID"]
    .apply(lambda x: "in actuals" if x in hc_positions else "not in actuals")
)

# =====================================================
# Output
# =====================================================

NewJoiners_HC_flag_df = New_Joiners_prepared_joined_df

output_dataset = dataiku.Dataset("NewJoiners_HC_flag")
output_dataset.write_with_schema(NewJoiners_HC_flag_df)
