# -*- coding: utf-8 -*-

import dataiku
import pandas as pd
from io import BytesIO
from datetime import datetime, timedelta
from openpyxl import load_workbook
from openpyxl.styles import Alignment, PatternFill, Font
from openpyxl.utils import get_column_letter

# =====================================================
# CONFIG
# =====================================================

ENABLE_MT_MERGE = True

MERGE_MT = {
    "GCIO": ["GCIO-WEB", "GCIO-CIB"]
}

SKIP_MT = {
    "OPS WRB",
    "OPS CIB",
    "FCSO"
}

SKIP_MT = {x.strip().upper() for x in SKIP_MT}

# =====================================================
# OUTPUT FOLDER
# =====================================================

output_folder = dataiku.Folder("yvmNqbID")

# =====================================================
# LOAD DATASETS (KEEP #NA)
# =====================================================

def load_dataset(name):

    return dataiku.Dataset(name).get_dataframe(
        na_values=[],
        keep_default_na=False
    )

report_df = load_dataset("Report")
hc_df     = load_dataset("TnO_Central_HC")
nj_df     = load_dataset("Newjoiner")
lv_df     = load_dataset("leavers")
jr_df     = load_dataset("JR")
fg_df     = load_dataset("FG")
tf_df     = load_dataset("transfer")

# =====================================================
# CLEAN COLUMN NAMES
# =====================================================

report_df.columns = report_df.columns.str.strip()
hc_df.columns     = hc_df.columns.str.strip()
nj_df.columns     = nj_df.columns.str.strip()
lv_df.columns     = lv_df.columns.str.strip()
jr_df.columns     = jr_df.columns.str.strip()
fg_df.columns     = fg_df.columns.str.strip()
tf_df.columns     = tf_df.columns.str.strip()

# =====================================================
# NORMALIZE
# =====================================================

def normalize(series):

    return series.astype(str).str.strip().str.upper()

# =====================================================
# STYLING
# =====================================================

HEADER_FILL = PatternFill(
    start_color="1F4E78",
    end_color="1F4E78",
    fill_type="solid"
)

HEADER_FONT = Font(
    color="FFFFFF",
    bold=True
)

CENTER_ALIGN = Alignment(
    horizontal="center",
    vertical="center",
    wrap_text=True
)

TOTAL_FILL = PatternFill(
    start_color="D9D9D9",
    end_color="D9D9D9",
    fill_type="solid"
)

TOTAL_FONT = Font(bold=True)

# =====================================================
# HELPERS
# =====================================================

def style_headers(ws):

    for cell in ws[1]:

        if cell.value not in [None, ""]:

            cell.fill = HEADER_FILL
            cell.font = HEADER_FONT
            cell.alignment = CENTER_ALIGN

def style_total_row(ws):

    last_row = ws.max_row

    for col in range(1, ws.max_column + 1):

        cell = ws.cell(last_row, col)

        cell.fill = TOTAL_FILL
        cell.font = TOTAL_FONT
        cell.alignment = CENTER_ALIGN

def wrap_report_headers(ws):

    for cell in ws[1]:

        if cell.value:

            cell.alignment = Alignment(
                wrap_text=True,
                vertical="center",
                horizontal="center"
            )

# =====================================================
# BUILD MT LIST FROM REPORT
# =====================================================

if "MT Domain" not in report_df.columns:

    raise Exception(
        f"MT Domain column missing in Report! "
        f"Columns found: {list(report_df.columns)}"
    )

raw_mts = normalize(
    report_df["MT Domain"]
).dropna().unique()

raw_mts = [
    mt
    for mt in raw_mts
    if mt not in SKIP_MT
]

# =====================================================
# MT GROUPING
# =====================================================

mt_groups = {}

if ENABLE_MT_MERGE:

    for group, values in MERGE_MT.items():

        mt_groups[group] = values

    for mt in raw_mts:

        if not any(mt in v for v in MERGE_MT.values()):

            mt_groups[mt] = [mt]

else:

    for mt in raw_mts:

        mt_groups[mt] = [mt]

# =====================================================
# DATE
# =====================================================

today = datetime.today()

last_month_end = (
    today.replace(day=1)
    - timedelta(days=1)
)

date_str = last_month_end.strftime("%d%b%y")

# =====================================================
# MAIN LOOP
# =====================================================

for mt_name, mt_list in mt_groups.items():

    # -------------------------------------------------
    # FILTER REPORT
    # -------------------------------------------------

    report_f = report_df[
        normalize(report_df["MT Domain"]).isin(mt_list)
    ].copy()

    hc_f = hc_df[
        normalize(hc_df["MT Domain"]).isin(mt_list)
    ].copy()

    nj_f = nj_df[
        normalize(nj_df["MT Domain"]).isin(mt_list)
    ].copy()

    lv_f = lv_df[
        normalize(lv_df["MT Domain"]).isin(mt_list)
    ].copy()

    jr_f = jr_df[
        normalize(jr_df["MT Domain"]).isin(mt_list)
    ].copy()

    fg_f = fg_df[
        normalize(fg_df["MT Domain"]).isin(mt_list)
    ].copy()

    # -------------------------------------------------
    # TRANSFER FILTER
    # -------------------------------------------------

    cond1 = normalize(
        tf_df["MT Domain(To)"]
    ).isin(mt_list)

    cond2 = normalize(
        tf_df["MT Domain (actual)"]
    ).isin(mt_list)

    tf_f = tf_df[
        cond1 | cond2
    ].copy()

    # =================================================
    # CLEAN HEADERS
    # =================================================

    for df in [
        report_f,
        hc_f,
        nj_f,
        lv_f,
        jr_f,
        fg_f,
        tf_f
    ]:

        df.columns = [
            ""
            if str(col).startswith("col_")
            or str(col).startswith("Unnamed")
            else col
            for col in df.columns
        ]

    # =================================================
    # CREATE EXCEL
    # =================================================

    stream = BytesIO()

    with pd.ExcelWriter(
        stream,
        engine="openpyxl"
    ) as writer:

        report_f.to_excel(
            writer,
            sheet_name="Report",
            index=False
        )

        hc_f.to_excel(
            writer,
            sheet_name="1_HC_Data",
            index=False
        )

        nj_f.to_excel(
            writer,
            sheet_name="2_NewJoiner",
            index=False
        )

        lv_f.to_excel(
            writer,
            sheet_name="3_Leavers",
            index=False
        )

        jr_f.to_excel(
            writer,
            sheet_name="4_JR",
            index=False
        )

        fg_f.to_excel(
            writer,
            sheet_name="5_FG",
            index=False
        )

        tf_f.to_excel(
            writer,
            sheet_name="6_Transfer",
            index=False
        )

    stream.seek(0)

    # =================================================
    # POST PROCESS
    # =================================================

    wb = load_workbook(stream)

    for ws in wb.worksheets:

        ws.freeze_panes = "A2"

        # ---------------------------------------------
        # REPORT SHEET
        # ---------------------------------------------

        if ws.title == "Report":

            wrap_report_headers(ws)

            # -----------------------------------------
            # FIX HEADERS
            # -----------------------------------------

            for cell in ws[1]:

                if (
                    isinstance(cell.value, str)
                    and
                    (
                        cell.value.startswith("Unnamed")
                        or
                        cell.value.startswith("col_")
                    )
                ):

                    cell.value = ""

            last_row = ws.max_row
            total_row = last_row + 1

            ws.cell(total_row, 1, "TOTAL")

            # -----------------------------------------
            # ROUND + FORMAT
            # -----------------------------------------

            for r in range(2, last_row + 1):

                for c in range(2, ws.max_column + 1):

                    cell = ws.cell(r, c)

                    val = cell.value

                    if pd.notnull(val):

                        try:

                            num = float(val)

                            cell.value = round(num)

                            cell.number_format = '#,##0'

                            cell.alignment = CENTER_ALIGN

                        except:

                            pass

            # -----------------------------------------
            # TOTAL ROW
            # -----------------------------------------

            for col in range(2, ws.max_column + 1):

                values = []
                has_non_numeric = False

                for r in range(2, last_row + 1):

                    val = ws.cell(r, col).value

                    if val in [None, ""]:
                        continue

                    try:

                        num = float(val)

                        values.append(num)

                    except:

                        has_non_numeric = True

                if (
                    has_non_numeric
                    or
                    len(values) == 0
                ):
                    continue

                total_val = round(sum(values))

                total_cell = ws.cell(
                    total_row,
                    col,
                    total_val
                )

                total_cell.number_format = '#,##0'

                total_cell.alignment = CENTER_ALIGN

            style_total_row(ws)

        # ---------------------------------------------
        # STYLE HEADERS
        # ---------------------------------------------

        style_headers(ws)

        # ---------------------------------------------
        # COLUMN WIDTH
        # ---------------------------------------------

        for col in ws.columns:

            max_len = 0

            col_letter = get_column_letter(
                col[0].column
            )

            for cell in col:

                if cell.value:

                    max_len = max(
                        max_len,
                        len(str(cell.value))
                    )

            ws.column_dimensions[
                col_letter
            ].width = min(max_len + 1, 25)

    # =================================================
    # SAVE FINAL FILE
    # =================================================

    final_stream = BytesIO()

    wb.save(final_stream)

    final_stream.seek(0)

    safe_mt = (
        str(mt_name)
        .replace("/", "_")
        .replace(" ", "_")
    )

    file_name = (
        f"T&O_HC_{date_str}_{safe_mt}.xlsx"
    )

    with output_folder.get_writer(file_name) as writer:

        writer.write(final_stream.read())

print("✅ FINAL DATAIKU VERSION READY")
