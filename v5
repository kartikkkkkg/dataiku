# -*- coding: utf-8 -*-

import dataiku
import pandas as pd
from io import BytesIO
from datetime import datetime, timedelta
from openpyxl import load_workbook
from openpyxl.styles import Alignment, PatternFill, Font
from openpyxl.utils import get_column_letter

# =====================================================
# CONFIG
# =====================================================

ENABLE_MT_MERGE = False

MERGE_MT = {
    "GCIO": ["GCIO-WEB", "GCIO-CIB"]
}

SKIP_MT = {
    "OPS WRB",
    "OPS CIB",
    "FCSO"
}

SKIP_MT = {x.strip().upper() for x in SKIP_MT}

# =====================================================
# OUTPUT FOLDER
# =====================================================

output_folder = dataiku.Folder("yvmNqbID")

# =====================================================
# LOAD DATASETS
# =====================================================

def load_dataset(name):

    return dataiku.Dataset(name).get_dataframe(
        na_values=[],
        keep_default_na=False
    )

report_df = load_dataset("Report")
hc_df     = load_dataset("TnO_Central_HC")
nj_df     = load_dataset("Newjoiner")
lv_df     = load_dataset("leavers")
jr_df     = load_dataset("JR")
fg_df     = load_dataset("FG")
tf_df     = load_dataset("transfer")

# =====================================================
# CLEAN COLUMN NAMES
# =====================================================

for df in [
    report_df,
    hc_df,
    nj_df,
    lv_df,
    jr_df,
    fg_df,
    tf_df
]:

    df.columns = df.columns.str.strip()

# =====================================================
# CHECK REQUIRED COLUMNS
# =====================================================

required_cols = {
    "Report": ["MT Domain"],
    "TnO_Central_HC": ["MT Domain"],
    "Newjoiner": ["MT Domain"],
    "leavers": ["MT Domain"],
    "JR": ["MT Domain"],
    "FG": ["MT Domain"],
    "transfer": ["MT Domain(To)", "MT Domain (actual)"]
}

dataset_map = {
    "Report": report_df,
    "TnO_Central_HC": hc_df,
    "Newjoiner": nj_df,
    "leavers": lv_df,
    "JR": jr_df,
    "FG": fg_df,
    "transfer": tf_df
}

for ds_name, cols in required_cols.items():

    df = dataset_map[ds_name]

    for col in cols:

        if col not in df.columns:

            raise Exception(
                f"{col} missing in {ds_name}. "
                f"Columns found: {list(df.columns)}"
            )

# =====================================================
# CREATE NORMALIZED MT HELPER COLUMNS
# =====================================================

report_df["_MT_"] = report_df["MT Domain"].astype(str).str.strip().str.upper()

hc_df["_MT_"] = hc_df["MT Domain"].astype(str).str.strip().str.upper()

nj_df["_MT_"] = nj_df["MT Domain"].astype(str).str.strip().str.upper()

lv_df["_MT_"] = lv_df["MT Domain"].astype(str).str.strip().str.upper()

jr_df["_MT_"] = jr_df["MT Domain"].astype(str).str.strip().str.upper()

fg_df["_MT_"] = fg_df["MT Domain"].astype(str).str.strip().str.upper()

tf_df["_MT_TO_"] = tf_df["MT Domain(To)"].astype(str).str.strip().str.upper()

tf_df["_MT_ACTUAL_"] = tf_df["MT Domain (actual)"].astype(str).str.strip().str.upper()

# =====================================================
# STYLES
# =====================================================

HEADER_FILL = PatternFill(
    start_color="1F4E78",
    end_color="1F4E78",
    fill_type="solid"
)

HEADER_FONT = Font(
    color="FFFFFF",
    bold=True
)

CENTER_ALIGN = Alignment(
    horizontal="center",
    vertical="center",
    wrap_text=True
)

TOTAL_FILL = PatternFill(
    start_color="D9D9D9",
    end_color="D9D9D9",
    fill_type="solid"
)

TOTAL_FONT = Font(bold=True)

# =====================================================
# HELPERS
# =====================================================

def style_headers(ws):

    for cell in ws[1]:

        if cell.value not in [None, ""]:

            cell.fill = HEADER_FILL
            cell.font = HEADER_FONT
            cell.alignment = CENTER_ALIGN

def style_total_row(ws):

    last_row = ws.max_row

    for col in range(1, ws.max_column + 1):

        cell = ws.cell(last_row, col)

        cell.fill = TOTAL_FILL
        cell.font = TOTAL_FONT
        cell.alignment = CENTER_ALIGN

# =====================================================
# BUILD MT LIST FROM REPORT
# =====================================================

raw_mts = report_df["_MT_"].dropna().unique()

raw_mts = [
    mt
    for mt in raw_mts
    if mt not in SKIP_MT
]

# =====================================================
# MT GROUPING
# =====================================================

mt_groups = {}

if ENABLE_MT_MERGE:

    for group, values in MERGE_MT.items():

        mt_groups[group] = [
            x.strip().upper()
            for x in values
        ]

    for mt in raw_mts:

        if not any(
            mt in v
            for v in MERGE_MT.values()
        ):

            mt_groups[mt] = [mt]

else:

    for mt in raw_mts:

        mt_groups[mt] = [mt]

# =====================================================
# DATE
# =====================================================

today = datetime.today()

last_month_end = (
    today.replace(day=1)
    - timedelta(days=1)
)

date_str = last_month_end.strftime("%d%b%y")

# =====================================================
# MAIN LOOP
# =====================================================

for mt_name, mt_list in mt_groups.items():

    # -------------------------------------------------
    # FILTER FUNCTION
    # -------------------------------------------------

    def filter_df(df):

        if "_MT_" not in df.columns:
            return pd.DataFrame()

        return df[
            df["_MT_"].isin(mt_list)
        ].copy()

    # -------------------------------------------------
    # FILTER ALL DATA
    # -------------------------------------------------

    report_f = filter_df(report_df)
    hc_f     = filter_df(hc_df)
    nj_f     = filter_df(nj_df)
    lv_f     = filter_df(lv_df)
    jr_f     = filter_df(jr_df)
    fg_f     = filter_df(fg_df)

    # -------------------------------------------------
    # TRANSFER FILTER
    # -------------------------------------------------

    cond1 = tf_df["_MT_TO_"].isin(mt_list)

    cond2 = tf_df["_MT_ACTUAL_"].isin(mt_list)

    tf_f = tf_df[
        cond1 | cond2
    ].copy()

    # =================================================
    # REMOVE HELPER COLUMNS
    # =================================================

    for df in [
        report_f,
        hc_f,
        nj_f,
        lv_f,
        jr_f,
        fg_f,
        tf_f
    ]:

        drop_cols = [
            col
            for col in df.columns
            if col.startswith("_MT")
        ]

        df.drop(
            columns=drop_cols,
            inplace=True,
            errors="ignore"
        )

    # =================================================
    # CLEAN HEADERS
    # =================================================

    for df in [
        report_f,
        hc_f,
        nj_f,
        lv_f,
        jr_f,
        fg_f,
        tf_f
    ]:

        df.columns = [
            ""
            if str(col).startswith("col_")
            or str(col).startswith("Unnamed")
            else col
            for col in df.columns
        ]

    # =================================================
    # CREATE EXCEL
    # =================================================

    stream = BytesIO()

    with pd.ExcelWriter(
        stream,
        engine="openpyxl"
    ) as writer:

        report_f.to_excel(
            writer,
            sheet_name="Report",
            index=False
        )

        hc_f.to_excel(
            writer,
            sheet_name="1_HC_Data",
            index=False
        )

        nj_f.to_excel(
            writer,
            sheet_name="2_NewJoiner",
            index=False
        )

        lv_f.to_excel(
            writer,
            sheet_name="3_Leavers",
            index=False
        )

        jr_f.to_excel(
            writer,
            sheet_name="4_JR",
            index=False
        )

        fg_f.to_excel(
            writer,
            sheet_name="5_FG",
            index=False
        )

        tf_f.to_excel(
            writer,
            sheet_name="6_Transfer",
            index=False
        )

    stream.seek(0)

    # =================================================
    # POST PROCESS
    # =================================================

    wb = load_workbook(stream)

    for ws in wb.worksheets:

        ws.freeze_panes = "A2"

        # =================================================
        # REPORT SHEET LOGIC
        # =================================================

        if ws.title == "Report":

            last_row = ws.max_row
            total_row = last_row + 1

            ws.cell(total_row, 1, "TOTAL")

            # ---------------------------------------------
            # ROUND + FORMAT VALUES
            # ---------------------------------------------

            for r in range(2, last_row + 1):

                for c in range(2, ws.max_column + 1):

                    cell = ws.cell(r, c)

                    val = cell.value

                    if pd.notnull(val):

                        try:

                            num = float(val)

                            cell.value = round(num)

                            cell.number_format = '#,##0'

                            cell.alignment = CENTER_ALIGN

                        except:

                            pass

            # ---------------------------------------------
            # TOTAL ROW
            # ---------------------------------------------

            for col in range(2, ws.max_column + 1):

                values = []

                has_non_numeric = False

                for r in range(2, last_row + 1):

                    val = ws.cell(r, col).value

                    if val in [None, ""]:
                        continue

                    try:

                        num = float(val)

                        values.append(num)

                    except:

                        has_non_numeric = True

                if (
                    has_non_numeric
                    or
                    len(values) == 0
                ):
                    continue

                total_val = round(sum(values))

                total_cell = ws.cell(
                    total_row,
                    col,
                    total_val
                )

                total_cell.number_format = '#,##0'

                total_cell.alignment = CENTER_ALIGN

            # ---------------------------------------------
            # TOTAL STYLE
            # ---------------------------------------------

            style_total_row(ws)

        # =================================================
        # STYLE HEADERS
        # =================================================

        style_headers(ws)

        # =================================================
        # COLUMN WIDTH
        # =================================================

        for col in ws.columns:

            max_len = 0

            col_letter = get_column_letter(
                col[0].column
            )

            for cell in col:

                if cell.value:

                    max_len = max(
                        max_len,
                        len(str(cell.value))
                    )

            ws.column_dimensions[
                col_letter
            ].width = min(max_len + 2, 30)

    # =================================================
    # SAVE FINAL FILE
    # =================================================

    final_stream = BytesIO()

    wb.save(final_stream)

    final_stream.seek(0)

    safe_mt = (
        str(mt_name)
        .replace("/", "_")
        .replace(" ", "_")
    )

    file_name = (
        f"T&O_HC_{date_str}_{safe_mt}.xlsx"
    )

    with output_folder.get_writer(file_name) as writer:

        writer.write(final_stream.read())

print("✅ FINAL WORKING DATAIKU VERSION READY")
