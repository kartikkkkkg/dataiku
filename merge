# -*- coding: utf-8 -*-

import dataiku
import pandas as pd
from datetime import datetime

# =========================================================
# CHANGE INPUT DATASET NAMES HERE
# =========================================================

HEADCOUNT_DATASET = "CHANGE_HEADCOUNT_DATASET_NAME"
NEW_JOINER_DATASET = "CHANGE_NEW_JOINER_DATASET_NAME"
LEAVERS_DATASET = "CHANGE_LEAVERS_DATASET_NAME"
JR_DATASET = "CHANGE_JR_DATASET_NAME"
FG_DATASET = "CHANGE_FG_DATASET_NAME"
TRANSFERS_DATASET = "CHANGE_TRANSFERS_DATASET_NAME"

# =========================================================
# CHANGE OUTPUT MANAGED FOLDER NAME HERE
# =========================================================

OUTPUT_FOLDER = "CHANGE_OUTPUT_FOLDER_NAME"

# =========================================================
# CHANGE OUTPUT DATASET NAME HERE
# =========================================================

OUTPUT_DATASET = "CHANGE_OUTPUT_DATASET_NAME"

# =========================================================
# READ INPUT DATASETS
# =========================================================

headcount_df = dataiku.Dataset(
    HEADCOUNT_DATASET
).get_dataframe()

new_joiner_df = dataiku.Dataset(
    NEW_JOINER_DATASET
).get_dataframe()

leavers_df = dataiku.Dataset(
    LEAVERS_DATASET
).get_dataframe()

jr_df = dataiku.Dataset(
    JR_DATASET
).get_dataframe()

fg_df = dataiku.Dataset(
    FG_DATASET
).get_dataframe()

transfers_df = dataiku.Dataset(
    TRANSFERS_DATASET
).get_dataframe()

# =========================================================
# DYNAMIC FILE NAME
# =========================================================

today = datetime.today()

date_str = today.strftime("%d%b%y")

file_name = f"T&O_HC_{date_str}.xlsx"

# =========================================================
# CREATE EXCEL FILE
# =========================================================

output_path = f"/tmp/{file_name}"

with pd.ExcelWriter(output_path, engine="openpyxl") as writer:

    # -----------------------------------------------------
    # HEADCOUNT SHEET
    # -----------------------------------------------------

    headcount_df.to_excel(
        writer,
        sheet_name="Headcount",
        index=False
    )

    # -----------------------------------------------------
    # NEW JOINERS SHEET
    # -----------------------------------------------------

    new_joiner_df.to_excel(
        writer,
        sheet_name="New Joiners",
        index=False
    )

    # -----------------------------------------------------
    # LEAVERS SHEET
    # -----------------------------------------------------

    leavers_df.to_excel(
        writer,
        sheet_name="Leavers",
        index=False
    )

    # -----------------------------------------------------
    # JR SHEET
    # -----------------------------------------------------

    jr_df.to_excel(
        writer,
        sheet_name="JR",
        index=False
    )

    # -----------------------------------------------------
    # FG SHEET
    # -----------------------------------------------------

    fg_df.to_excel(
        writer,
        sheet_name="FG",
        index=False
    )

    # -----------------------------------------------------
    # TRANSFERS SHEET
    # -----------------------------------------------------

    transfers_df.to_excel(
        writer,
        sheet_name="Transfers",
        index=False
    )

# =========================================================
# SAVE EXCEL FILE TO MANAGED FOLDER
# =========================================================

folder = dataiku.Folder(OUTPUT_FOLDER)

with folder.get_writer(file_name) as writer:
    with open(output_path, "rb") as f:
        writer.write(f.read())

# =========================================================
# CREATE OUTPUT DATASET
# =========================================================

output_df = pd.DataFrame({
    "File_Name": [file_name],
    "Created_On": [datetime.now()],
    "Status": ["Success"]
})

# =========================================================
# WRITE OUTPUT DATASET
# =========================================================

output_dataset = dataiku.Dataset(OUTPUT_DATASET)

output_dataset.write_with_schema(output_df)

# =========================================================
# SUCCESS MESSAGE
# =========================================================

print("====================================")
print("Excel File Created Successfully")
print("====================================")
print(file_name)
print("Saved to folder:", OUTPUT_FOLDER)
print("====================================")
