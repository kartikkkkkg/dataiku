# -*- coding: utf-8 -*-

import dataiku
import pandas as pd
import numpy as np
from datetime import datetime

# =========================================================
# CHANGE INPUT DATASET NAMES HERE
# =========================================================

HEADCOUNT_DATASET = "MSTR_HC_joined_joineddd_joined_prepared_joined"

NEW_JOINER_DATASET = "NJ_hc_flag_joined_prepared"

LEAVERS_DATASET = "Leavers_HC_Flagged_prepared"

JR_DATASET = "JR_Trf_check_prepared_prepared_prepared_prepared"

FG_DATASET = "fg_clean"

TRANSFERS_DATASET = "transfers_prepared_joined_joined_prepared_prepared_prepared"

# =========================================================
# CHANGE OUTPUT MANAGED FOLDER NAME HERE
# =========================================================

OUTPUT_FOLDER = "Central_Reports"

# =========================================================
# CHANGE OUTPUT DATASET NAME HERE
# =========================================================

OUTPUT_DATASET = "Central"

# =========================================================
# READ INPUT DATASETS
# =========================================================

headcount_df = dataiku.Dataset(
    HEADCOUNT_DATASET
).get_dataframe()

new_joiner_df = dataiku.Dataset(
    NEW_JOINER_DATASET
).get_dataframe()

leavers_df = dataiku.Dataset(
    LEAVERS_DATASET
).get_dataframe()

jr_df = dataiku.Dataset(
    JR_DATASET
).get_dataframe()

fg_df = dataiku.Dataset(
    FG_DATASET
).get_dataframe()

transfers_df = dataiku.Dataset(
    TRANSFERS_DATASET
).get_dataframe()

# =========================================================
# REMOVE TIMEZONE ISSUE FOR EXCEL
# =========================================================

def remove_timezone(df):

    for col in df.columns:

        try:

            if pd.api.types.is_datetime64tz_dtype(df[col]):
                df[col] = df[col].dt.tz_localize(None)

        except:
            pass

    return df

headcount_df = remove_timezone(headcount_df)

new_joiner_df = remove_timezone(new_joiner_df)

leavers_df = remove_timezone(leavers_df)

jr_df = remove_timezone(jr_df)

fg_df = remove_timezone(fg_df)

transfers_df = remove_timezone(transfers_df)

# =========================================================
# POSITION ID CLEANUP
# REMOVE .0 FROM POSITION IDs
# =========================================================

def clean_position_id(df):

    for col in df.columns:

        if "Position ID" in col:

            try:

                df[col] = (
                    pd.to_numeric(df[col], errors="coerce")
                    .fillna(0)
                    .astype("Int64")
                    .astype(str)
                    .replace("<NA>", "")
                    .replace("0", "")
                )

            except:
                pass

    return df

headcount_df = clean_position_id(headcount_df)

new_joiner_df = clean_position_id(new_joiner_df)

leavers_df = clean_position_id(leavers_df)

jr_df = clean_position_id(jr_df)

fg_df = clean_position_id(fg_df)

transfers_df = clean_position_id(transfers_df)

# =========================================================
# DYNAMIC FILE NAME
# =========================================================

today = datetime.today()

date_str = today.strftime("%d%b%y")

# Example:
# T&O_HC_25May26.xlsx

file_name = f"T&O_HC_{date_str}.xlsx"

# =========================================================
# CREATE EXCEL FILE
# =========================================================

output_path = f"/tmp/{file_name}"

with pd.ExcelWriter(output_path, engine="openpyxl") as writer:

    # -----------------------------------------------------
    # HEADCOUNT SHEET
    # -----------------------------------------------------

    headcount_df.to_excel(
        writer,
        sheet_name="Headcount",
        index=False
    )

    # -----------------------------------------------------
    # NEW JOINERS SHEET
    # -----------------------------------------------------

    new_joiner_df.to_excel(
        writer,
        sheet_name="New Joiners",
        index=False
    )

    # -----------------------------------------------------
    # LEAVERS SHEET
    # -----------------------------------------------------

    leavers_df.to_excel(
        writer,
        sheet_name="Leavers",
        index=False
    )

    # -----------------------------------------------------
    # JR SHEET
    # -----------------------------------------------------

    jr_df.to_excel(
        writer,
        sheet_name="JR",
        index=False
    )

    # -----------------------------------------------------
    # FG SHEET
    # -----------------------------------------------------

    fg_df.to_excel(
        writer,
        sheet_name="FG",
        index=False
    )

    # -----------------------------------------------------
    # TRANSFERS SHEET
    # -----------------------------------------------------

    transfers_df.to_excel(
        writer,
        sheet_name="Transfers",
        index=False
    )

# =========================================================
# SAVE EXCEL FILE TO MANAGED FOLDER
# =========================================================

folder = dataiku.Folder(OUTPUT_FOLDER)

with folder.get_writer(file_name) as writer:

    with open(output_path, "rb") as f:

        writer.write(f.read())

# =========================================================
# CREATE OUTPUT DATASET
# =========================================================

output_df = pd.DataFrame({

    "File_Name": [file_name],

    "Created_On": [datetime.now()],

    "Status": ["Success"]

})

# =========================================================
# WRITE OUTPUT DATASET
# =========================================================

output_dataset = dataiku.Dataset(OUTPUT_DATASET)

output_dataset.write_with_schema(output_df)

# =========================================================
# SUCCESS MESSAGE
# =========================================================

print("====================================")

print("Excel File Created Successfully")

print("====================================")

print("File Name :", file_name)

print("Managed Folder :", OUTPUT_FOLDER)

print("Output Dataset :", OUTPUT_DATASET)

print("====================================")
