
# -*- coding: utf-8 -*-

import dataiku
import pandas as pd
import numpy as np
from datetime import datetime
import os

# =========================================================
# READ INPUT DATASETS
# =========================================================

fg_clean = dataiku.Dataset("fg_clean")
fg_clean_df = fg_clean.get_dataframe()

JR_Trf_check_prepared_prepared_prepared_prepared = dataiku.Dataset(
    "JR_Trf_check_prepared_prepared_prepared_prepared"
)
JR_Trf_check_prepared_prepared_prepared_prepared_df = (
    JR_Trf_check_prepared_prepared_prepared_prepared.get_dataframe()
)

transfers_prepared_joined_joined_prepared_prepared_prepared = dataiku.Dataset(
    "transfers_prepared_joined_joined_prepared_prepared_prepared"
)
transfers_prepared_joined_joined_prepared_prepared_prepared_df = (
    transfers_prepared_joined_joined_prepared_prepared_prepared.get_dataframe()
)

NJ_hc_flag_joined_prepared = dataiku.Dataset(
    "NJ_hc_flag_joined_prepared"
)
NJ_hc_flag_joined_prepared_df = (
    NJ_hc_flag_joined_prepared.get_dataframe()
)

Leavers_HC_Flagged_prepared = dataiku.Dataset(
    "Leavers_HC_Flagged_prepared"
)
Leavers_HC_Flagged_prepared_df = (
    Leavers_HC_Flagged_prepared.get_dataframe()
)

MSTR_HC_joined_joineddd_joined_prepared_joined = dataiku.Dataset(
    "MSTR_HC_joined_joineddd_joined_prepared_joined"
)
MSTR_HC_joined_joineddd_joined_prepared_joined_df = (
    MSTR_HC_joined_joineddd_joined_prepared_joined.get_dataframe()
)

# =========================================================
# DYNAMIC FILE NAME
# =========================================================

today = datetime.today()

date_str = today.strftime("%d%b%y")

# Example:
# T&O_HC_25May26.xlsx

file_name = f"T&O_HC_{date_str}.xlsx"

# =========================================================
# CREATE EXCEL FILE
# =========================================================

output_path = f"/tmp/{file_name}"

with pd.ExcelWriter(output_path, engine="openpyxl") as writer:

    # -----------------------------------------------------
    # HEADCOUNT
    # -----------------------------------------------------

    MSTR_HC_joined_joineddd_joined_prepared_joined_df.to_excel(
        writer,
        sheet_name="Headcount",
        index=False
    )

    # -----------------------------------------------------
    # NEW JOINERS
    # -----------------------------------------------------

    NJ_hc_flag_joined_prepared_df.to_excel(
        writer,
        sheet_name="New Joiners",
        index=False
    )

    # -----------------------------------------------------
    # LEAVERS
    # -----------------------------------------------------

    Leavers_HC_Flagged_prepared_df.to_excel(
        writer,
        sheet_name="Leavers",
        index=False
    )

    # -----------------------------------------------------
    # JR
    # -----------------------------------------------------

    JR_Trf_check_prepared_prepared_prepared_prepared_df.to_excel(
        writer,
        sheet_name="JR",
        index=False
    )

    # -----------------------------------------------------
    # FG
    # -----------------------------------------------------

    fg_clean_df.to_excel(
        writer,
        sheet_name="FG",
        index=False
    )

    # -----------------------------------------------------
    # TRANSFERS
    # -----------------------------------------------------

    transfers_prepared_joined_joined_prepared_prepared_prepared_df.to_excel(
        writer,
        sheet_name="Transfers",
        index=False
    )

# =========================================================
# SAVE FILE TO MANAGED FOLDER
# =========================================================

# Replace "Central" if your managed folder name is different

folder = dataiku.Folder("Central")

with folder.get_writer(file_name) as writer:
    with open(output_path, "rb") as f:
        writer.write(f.read())

# =========================================================
# CREATE SMALL OUTPUT DATASET
# =========================================================

Central_df = pd.DataFrame({
    "File_Name": [file_name],
    "Created_On": [datetime.now()],
    "Status": ["Success"]
})

# =========================================================
# WRITE OUTPUT DATASET
# =========================================================

Central = dataiku.Dataset("Central")

Central.write_with_schema(Central_df)

print("Excel File Created Successfully")
print(file_name)
