# ==========================================================
# PREPARE NEW JOINER DATA
# ==========================================================
nj["Position ID"] = (
    nj["Position ID"]
    .astype(str)
    .str.replace(".0", "", regex=False)
    .str.strip()
)
nj["Effective Date"] = pd.to_datetime(
    nj["Effective Date"],
    errors="coerce"
).dt.normalize()
today = pd.Timestamp.today().normalize()
future_nj = (
    nj[nj["Effective Date"] >= today][["Position ID"]]
    .drop_duplicates()
)
future_nj["Check in NJ"] = "In New Joiner"
joined = joined.merge(
    future_nj,
    on="Position ID",
    how="left"
)

