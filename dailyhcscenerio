import dataiku
from dataiku.scenario import Scenario

scenario = Scenario()
client = dataiku.api_client()
project = client.get_default_project()

# Retrieve the variables generated by your Recipe (Step 1)
variables = project.get_variables()["standard"]
html_table = variables.get("HTML_EMAIL_TABLE", "<p>Error: Table not generated</p>")
report_date = variables.get("REPORT_DATE", "Today")

# Email Configuration
EMAIL_TO = "kartik.om"  
SENDER_EMAIL = "kartik.
SUBJECT = f"Daily Headcount | {report_date}"

body_html = f"""
<p>Hi all,<br>
PFB Headcount as of {report_date}</p>
{html_table}
"""

print(f"Triggering email for {report_date} from Scenario...")

try:
    # Uses the primary 'mail' channel ID
    sender = scenario.get_message_sender("mail")
    # -> Added as_html=True to render the table properly
    sender.send(sender=SENDER_EMAIL, recipient=EMAIL_TO, subject=SUBJECT, message=body_html, as_html=True)
    print("Email sent successfully via 'mail' channel.")
except Exception as e:
    print(f"Primary channel failed: {e}. Trying backup channel...")
    # Uses the backup 'fdmi-smtp' channel
    sender = scenario.get_message_sender("fdmi-smtp")
    # -> Added as_html=True to render the table properly
    sender.send(sender=SENDER_EMAIL, recipient=EMAIL_TO, subject=SUBJECT, message=body_html, as_html=True)
    print("Email sent successfully via 'fdmi-smtp' channel.")
